{
  "name": "@tc/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.ts"
  },
  "scripts": {
    "dev": "node ../../scripts/sync-theme.ts --stage publish --app web && next dev --port 3000",
