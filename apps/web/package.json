    "typecheck": "tsc --noEmit",
    "lint": "eslint -c ../../eslint.config.mjs ."
  },
  "dependencies": {
    "@aws-sdk/client-kms": "3.1166.0",
    "@aws-sdk/client-lambda": "3.1166.0",
    "@aws-sdk/client-sqs": "3.1166.0",
    "@tc/auth": "workspace:*",
    "@tc/core": "workspace:*",
    "@tc/db": "workspace:*",
    "@tc/eps": "workspace:*",
    "@tc/notify": "workspace:*",
    "@tc/ui": "workspace:*",
    "next": "16.4.6",
    "next-intl": "4.14.10",
    "qrcode-generator": "2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
