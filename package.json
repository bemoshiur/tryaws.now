{
  "name": "tryaws-now-platform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "lint": "eslint -c eslint.config.mjs .",
    "typecheck": "pnpm -r typecheck",
    "test": "node scripts/run-tests.mjs",
    "test:repeat": "node scripts/test-repeat.mjs",
    "spec:split": "node scripts/split-plan.mjs",
    "spec:check": "node scripts/split-plan.mjs --check",
    "e2e:wallet": "node scripts/smoke-wallet.mjs",
    "baseline:build": "node scripts/build-baseline.mjs",
    "baseline:check": "node scripts/build-baseline.mjs --check",
    "theme:sync": "node scripts/sync-theme.ts",
    "verify": "node scripts/verify.mjs",
    "e2e:auth": "node scripts/smoke-auth.mjs",
    "theme:scan": "node scripts/scan-theme-output.ts",
    "db:up": "docker compose up -d --wait postgres",
    "db:migrate": "pnpm --filter @tc/db migrate",
    "seed:kyc-verified": "node scripts/seed-kyc-verified.mjs",
    "seed:pool-account": "node scripts/seed-pool-account.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "sst": "4.17.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  }
}
